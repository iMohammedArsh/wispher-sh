{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app",
  "version": "0.0.1",
  "identifier": "com.administrator.tauri-app",
  "build": {
    "beforeDevCommand": "node scripts/ensure-vite.mjs",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wisper Dictation Assistant",
        "width": 900,
        "height": 650,
        "resizable": true,
        "decorations": false,
        "visible": true,
        "backgroundColor": "#f3f1ec",
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
