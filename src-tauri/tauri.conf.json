{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hams",
  "version": "0.2.0",
  "identifier": "com.wusla.hams",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430/main.html",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "main.html",
        "title": "Hams",
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 540,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "category": "Productivity",
    "shortDescription": "Voice typing that stays on your computer",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFRUMwMkYwNzNFQ0ZFMzQKUldRMC91eHo4QUxzbm5LbVc5OFZyVllqUThBU2dVNy9hSDB2WDFKbXM5aGVYclQ2TGxsUUJaVFcK",
      "endpoints": [
        "https://github.com/iMohammedArsh/wispher-sh/releases/latest/download/latest.json"
      ]
    }
  }
}
